[Unit]
Description=Connecting HTTPS WebSockets Relay Server (Oracle Cloud)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/connecting-relay-server
ExecStart=/home/ubuntu/.nvm/versions/node/v22.16.0/bin/node /opt/connecting-relay-server/server.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=PORT=8443

[Install]
WantedBy=multi-user.target
